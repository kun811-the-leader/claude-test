# ── Database ─────────────────────────────────────────────────────────────
# A real Postgres connection string. Free options: neon.tech, Supabase, or
# Vercel's own Postgres storage add-on. Local dev works the same way — point
# this at a local Postgres (or just use your free hosted one for dev too).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ── Anthropic (powers every AI Staff agent) ─────────────────────────────
# Without this, the app runs in Demo Mode: agents return clearly-labeled
# canned responses instead of real Claude output. See lib/llm/adapter.ts.
ANTHROPIC_API_KEY=

# ── Google OAuth (Gmail + Drive) ─────────────────────────────────────────
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# Without these, Integrations → Gmail/Drive show "연결 필요" and the mail
# checker / file organizer agents run in Mock Mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ── Transcription (meeting audio → text) ────────────────────────────────
# Any provider works behind lib/transcription/adapter.ts; example uses
# a generic key. Without it, Mark only accepts pasted/typed transcripts
# (which always works, no credential needed).
TRANSCRIPTION_API_KEY=

# ── Web search (market-researcher's research tool) ──────────────────────
# Without this, the research tool falls back to a Mock provider that
# returns clearly-labeled placeholder results instead of pretending to
# have searched the live web.
SEARCH_API_KEY=

# ── Auth / session secret (placeholder — see docs/ARCHITECTURE.md for the
# single-user-now / multi-workspace-later note) ──────────────────────────
AUTH_SECRET=change-me-in-production

# ── Scheduler ────────────────────────────────────────────────────────────
# Shared secret so only your own cron caller can hit /api/scheduler/tick.
SCHEDULER_SECRET=change-me-in-production
